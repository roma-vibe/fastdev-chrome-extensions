# Settings of this extension, read by vite.config.ts at build time: they go into dist/manifest.json
# and into the app as import.meta.env.VITE_*. `npm run build` creates .env from this file when it is
# missing; edit .env locally and keep this file in Git with the same keys.

# Name shown in Chrome and in the Chrome Web Store (at most 75 characters).
VITE_EXTENSION_NAME='Template Extension'
# Short description on chrome://extensions and in the store (at most 132 characters).
VITE_EXTENSION_DESCRIPTION='A Chrome extension built with Vue 3 and Tailwind CSS.'
# Version: one to four dot-separated numbers (0-65535), e.g. 1.2.0. Raise it for every store upload.
VITE_EXTENSION_VERSION=0.1.0
# Stable storage id of this extension: values saved under the older "<namespace>:<key>" keys are
# moved to plain keys on first read (src/services/storage).
VITE_STORAGE_NAMESPACE=template-extension
